# ============================================================================
# Tech-Life AI HR — sample environment file (REAL-WORLD configuration)
# Copy this file to ".env" in the project root and fill in real credentials.
#   cp .env.sample .env
#
# Design principle: secrets (SMTP passwords, API tokens, webhook secrets, DB
# credentials) live ONLY in environment variables, never in the CouchDB
# database. The Superadmin ➜ Integrations screen only stores which vendor is
# selected/enabled per category — never the credential values themselves.
# ============================================================================

# ---- Server ----
PORT=4000

# ---- Auth / sessions ----
JWT_SECRET=change-this-to-a-long-random-string-in-production

SUPERADMIN_EMAIL=superadmin@techlife.ai
SUPERADMIN_PASSWORD=SuperAdmin@123

# ============================================================================
# CouchDB (the platform's only database)
# ============================================================================
# Option A — single connection URL (takes priority if set):
#   COUCHDB_URL=http://admin:password@localhost:5984/techlifehr
COUCHDB_URL=

# Option B — granular parts (used to build the URL automatically if COUCHDB_URL
# is left blank). Use this form if you prefer not to put the password inline
# in a single URL string.
COUCHDB_HOST=localhost
COUCHDB_PORT=5984
COUCHDB_PROTOCOL=http
COUCHDB_USER=admin
COUCHDB_PASSWORD=password
COUCHDB_DBNAME=techlifehr

# If ALL of the above are left blank, the app falls back to an embedded,
# file-based CouchDB-protocol store under ./data/couch-local — useful for a
# quick local trial, but a real COUCHDB_URL (or the parts above) is what you
# want for any real deployment.

# ============================================================================
# Email (SMTP) — used for invite links and decision-result emails
# ============================================================================
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=hr@yourcompany.com
SMTP_FROM_NAME=Tech-Life AI HR

# ============================================================================
# WhatsApp — Meta WhatsApp Cloud API
# ============================================================================
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v20.0

# ============================================================================
# Telephony — outbound AI voice calls
# ============================================================================
# Twilio (simplest to stand up first)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Asterisk (AMI) — used instead of/alongside Twilio if configured
ASTERISK_AMI_HOST=
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USERNAME=
ASTERISK_AMI_SECRET=
ASTERISK_TRUNK_CONTEXT=from-internal

# FreeSWITCH (ESL) — used instead of/alongside Twilio if configured
FREESWITCH_ESL_HOST=
FREESWITCH_ESL_PORT=8021
FREESWITCH_ESL_PASSWORD=

# Which telephony vendor to use when a call is triggered: twilio | asterisk | freeswitch
TELEPHONY_VENDOR=twilio

# ============================================================================
# Chatwoot — message candidates via a real Chatwoot conversation (live chat / unified inbox)
# ============================================================================
# Your Chatwoot server URL (cloud or self-hosted), an agent API access token (Chatwoot >
# Profile Settings > Access Token), the account ID, and the inbox ID to create conversations in.
CHATWOOT_URL=
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_INBOX_ID=

# ============================================================================
# Mattermost — team chat alerts + optional meeting link
# ============================================================================
# Incoming Webhook URL for real-time HR/ops alerts (anger detected on a call, a case needs
# Management approval). Create one at: Mattermost > Integrations > Incoming Webhooks.
MATTERMOST_WEBHOOK_URL=
# Optional: override which channel the webhook posts to (leave blank to use the webhook's
# own default channel).
MATTERMOST_CHANNEL=hr-alerts

# Optional: use a Mattermost channel (with the Calls plugin enabled) as the interview meeting
# room instead of the platform's built-in WebRTC room. Set MEETING_VENDOR=mattermost to enable.
MEETING_VENDOR=builtin_webrtc
MATTERMOST_URL=
MATTERMOST_TEAM=
MATTERMOST_CHANNEL_NAME=

# ============================================================================
# Outbound Webhooks — real HMAC-signed delivery to your ATS/HRMS/CRM/BI stack
# ============================================================================
# Comma-separated list of URLs to POST every platform event to (interview.completed,
# decision.finalized, pretest.submitted, etc). Leave blank to disable delivery.
WEBHOOK_URLS=
# Shared secret used to HMAC-SHA256 sign every webhook payload (X-Signature header).
WEBHOOK_SECRET=change-this-webhook-signing-secret

# ============================================================================
# LLM / STT / TTS vendor keys (only needed if you switch off the built-in
# browser-based ASR/TTS on the Superadmin ➜ Integrations page)
# ============================================================================
LLM_PROVIDER=
LLM_API_KEY=
STT_PROVIDER=
STT_API_KEY=
TTS_PROVIDER=
TTS_API_KEY=
